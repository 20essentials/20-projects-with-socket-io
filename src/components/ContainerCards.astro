---

<section>
  {
    arrayCards.map(({ id, localImage, repo, title, colors }) => (
      <a
        href={repo}
        class='card'
        style={{
          '--color1': `${colors[0]}`,
          '--color2': `${colors[1]}`,
          '--color3': `${colors[2]}`
        }}
      >
        <img src={baseUrl(localImage)} alt={title} />
      </a>
    ))
  }
</section>

<style>
  section {
    min-height: 100vh;
    display: grid;
    padding: 2.2vmax;
    gap: 2.2vmax;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17vmax, 1fr));
  }

  @property --rotate {
    syntax: '<angle>';
    initial-value: 132deg;
    inherits: false;
  }

  .card {
    background: #000;
    aspect-ratio: 16 / 11;
    width: 16vmax;
    position: relative;
    padding: 0.5vmax;
    border-radius: 0.6vmax;
    justify-content: center;
    align-items: center;
    text-align: center;
    display: flex;
    color: rgb(88 199 250 / 0%);
    cursor: pointer;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: inherit;
      object-position: center;
    }
  }

  .card::before {
    content: '';
    inset: -0.4vmax;
    border-radius: inherit;
    background-image: linear-gradient(
      var(--rotate),
      var(--color1, #5ddcff),
      var(--color2, #3c67e3) 43%,
      var(--color3, #4e00c2)
    );
    position: absolute;
    z-index: -1;
    animation: spin 2.5s linear infinite;
  }

  .card::after {
    position: absolute;
    content: '';
    top: calc(var(--card-height) / 6);
    left: 0;
    right: 0;
    z-index: -1;
    height: 100%;
    width: 100%;
    margin: 0 auto;
    transform: scale(0.8);
    filter: blur(calc(var(--card-height) / 6));
    background-image: linear-gradient(
      var(--rotate),
      #5ddcff,
      #3c67e3 43%,
      #4e00c2
    );
    opacity: 1;
    transition: opacity 0.5s;
    animation: spin 2.5s linear infinite;
  }

  @keyframes spin {
    0% {
      --rotate: 0deg;
    }
    100% {
      --rotate: 360deg;
    }
  }
</style>
