---
import '@/styles/global.css';
import { baseUrl } from '@/utils/functions';
const favicon = baseUrl('/assets/favicon.webp');
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width' />
    <link rel='icon' type='image/svg+xml' href={favicon} />
    <title>20 Projects With Socket.io</title>
  </head>
  <body>
    <div class='background-div'></div>
    <slot />
  </body>
</html>

<style>
  .background-div {
    position: fixed;
    inset: 0;
    z-index: -10;
    min-height: 100vh;
    width: 100%;
    background-color: #000;
    overflow: hidden;
  }

  :global(.star) {
    position: absolute;
    top: 0;
    color: #fff;
    width: 20px;
    height: 20px;
    animation: animate 5s linear forwards;

    &::before {
      content: '';
      position: absolute;
      width: 100%;
      height: 100%;
      inset: 0;
      background-size: cover;
      background-image: url('/assets/star.svg');
      filter: drop-shadow(0 0 5px #fffc) drop-shadow(0 0 20px #fffc)
        drop-shadow(0 0 50px #fffc);
    }
  }

  @keyframes animate {
    0% {
      opacity: 1;
      transform: translateY(-10vh) rotate(0deg);
    }
    80% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      transform: translateY(100vh) rotate(360deg);
    }
  }
</style>

<script>
  import { $ } from '@/utils/functions';
  const $container = $('.background-div') as HTMLElement;

  function stars() {
    let e = document.createElement('div');
    e.setAttribute('class', 'star');
    $container.appendChild(e);
    const size = Math.random() * 2.5 + 1;
    const duration = Math.random() * 3;
    e.style.left = Math.random() * +innerWidth + 'px';
    e.style.width = `${size}vmax`;
    e.style.height = `${size}vmax`;
    e.style.animationDuration = `${duration + 2}s`;

    setTimeout(function () {
      $container.removeChild(e);
    }, 5000);
  }

  setInterval(function () {
    stars();
  }, 100);
</script>

